{
  "name": "parma-live",
  "private": true,
  "type": "module",
  "workspaces": [
    "app",
    "worker"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "dev:worker": "npm run dev -w worker",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces && tsc -p scripts",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
